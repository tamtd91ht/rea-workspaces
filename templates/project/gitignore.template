# Quy tắc ignore của dự án (scripts/new-project.mjs cài thành .gitignore).
# .gitignore không bảo vệ file đã được track:
# dùng `git rm --cached <file>` nếu lỡ commit thứ gì nhạy cảm.

# Output lớn, sinh tự động hoặc nhạy cảm
artifacts/*
!artifacts/README.md
evidence/raw/

# Capture và dump (có thể chứa cookie, token, dữ liệu cá nhân)
*.har
*.saz
*.pcap
*.pcapng
*.qlog
*.dmp
*.core

# Secret và cấu hình cục bộ
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*.token

# Settings Claude Code cục bộ
.claude/settings.local.json
CLAUDE.local.md

# File rác của hệ điều hành / editor
.DS_Store
Thumbs.db
desktop.ini
node_modules/
*.log
