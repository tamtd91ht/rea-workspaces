{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(rea-core/**)",
      "Write(rea-core/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx rea-agents setup:*)",
      "Bash(npx -y rea-agents@6.5.0 setup:*)",
      "Bash(npx rea-agents@latest setup:*)",
      "Bash(npx -y rea-agents@latest setup:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
